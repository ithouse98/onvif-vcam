<resources>
    <string name="app_name">VCam Agent</string>
    <string name="intro">Turns this phone\'s camera into an ONVIF camera through an ONVIF VCam server on the same network. The phone appears in the VCam panel → Agents.</string>
    <string name="lbl_server">VCam server IP (empty = find automatically)</string>
    <string name="hint_server">e.g. 192.168.1.10</string>
    <string name="lbl_port">Agent port</string>
    <string name="lbl_key">Agent key (as set in the VCam panel, empty if none)</string>
    <string name="lbl_name">Name shown in the VCam panel</string>
    <string name="lbl_resolution">Resolution</string>
    <string name="lbl_fps">FPS</string>
    <string name="lbl_bitrate">Max bitrate (kbps)</string>
    <string name="lbl_boot">Start automatically after the phone restarts</string>
    <string name="btn_start">Start</string>
    <string name="btn_stop">Stop</string>
    <string name="btn_battery">Allow running in the background (battery)</string>
    <string name="help">In the VCam panel open Agents and press \"+ monitor 0\" (back camera) or \"+ monitor 1\" (front camera). One camera streams at a time. Keep the phone on a charger for long tests.</string>
